{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "json": {
    "assist": { "enabled": true },
    "linter": { "enabled": true },

    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    },

    "formatter": {
      "enabled": true,

      /*
       * These formatter settings are already defined in Biome's root
       * formatter configuration, so duplicating them here is unnecessary.
       * Uncomment them only if JSON needs different formatting rules.

      // Indentation settings
      "indentStyle": "space",
      "indentWidth": 2,

      // Line settings
      "lineEnding": "lf",
      "lineWidth": 80,
      "trailingNewline": true,

      // Spacing and expansion settings
      "bracketSpacing": true,
      "expand": "auto",
      "delimiterSpacing": false

      */

      // JSON-specific settings
      "trailingCommas": "none"
    }
  }
}