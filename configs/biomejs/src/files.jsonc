{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "ignoreUnknown": false,
    "maxSize": 1048576,
    "includes": [
      "**",

      // Ignore root dirs
      "!/.qodo/**",
      "!/.husky/**",

      // Ignore dirs
      "!**/.tanstack/**",
      "!!**/.turbo/**",
      "!!**/coverage/**",
      "!!**/dist/**",
      "!**/node_modules/**",

      // Ignore root files
      "!/bun.lock"
    ]
  }
}