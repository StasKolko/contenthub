{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "css": {
    "assist": { "enabled": true },
    "linter": { "enabled": true },
    "globals": [],

    "parser": {
      "cssModules": true,
      "tailwindDirectives": true,
      "allowWrongLineComments": false
    },

    "formatter": {
      "enabled": true,

      /*
        * These formatter settings are already defined in Biome's root
        * formatter configuration, so duplicating them here is unnecessary.
        * Uncomment them only if CSS needs different formatting rules.

      // Indentation settings
      "indentStyle": "space",
      "indentWidth": 2,

      // Line settings
      "lineEnding": "lf",
      "lineWidth": 80,
      "trailingNewline": true,

      // Spacing settings
      "delimiterSpacing": false

      */

      // CSS-specific settings
      "quoteStyle": "double"
    }
  }
}