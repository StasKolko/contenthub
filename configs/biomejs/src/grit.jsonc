{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "grit": {
    "assist": { "enabled": false },
    "linter": { "enabled": false },
    "formatter": {
      "enabled": false

      /* 
        * Optional formatter overrides for Grit.
        * These settings are already defined in Biome's root formatter
        * configuration, so duplicating them here is unnecessary.
        * Uncomment them only if Grit needs different formatting rules.
      
      // Indentation settings
      "indentStyle": "space", 
      "indentWidth": 2,

      // Line settings
      "lineEnding": "lf",
      "lineWidth": 80,
      "trailingNewline": true

      */
    }
  }
}
