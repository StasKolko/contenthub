{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "overrides": [
    {
      "includes": [
        "**/vite.config.ts",
        "**/vitest.config.ts",
        "**/drizzle.config.ts"
      ],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/_tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            "useConsistentBuiltinInstantiation": "off",
            "noExcessiveLinesPerFile": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "useAwait": "off",
            "noThenProperty": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/scripts-utils/src/**", "scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
