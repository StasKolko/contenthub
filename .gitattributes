# ─── Baseline normalization ─────────────────────────────
* text=auto eol=lf

# ─── Force CRLF ─────────────────────────────────────────
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.sln           text eol=crlf

# ─── Force LF ───────────────────────────────────────────
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf
*.mk            text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf

# ─── Never touch ────────────────────────────────────────
*.patch         -text
*.diff          -text

# ─── Lockfiles ──────────────────────────────────────────
bun.lock        text eol=lf

# ─── Binary ─────────────────────────────────────────────

