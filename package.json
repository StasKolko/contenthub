{
  "name": "contenthub",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "configs/*",
      "contracts/*",
      "packages/*",
      "scripts/*"
    ],

    "catalogs": {
      "test": {
        "@edge-runtime/vm": "^5.0.0",
        "@solidjs/testing-library": "^0.8.10",
        "@testing-library/jest-dom": "^7.0.1",
        "@vitest/coverage-v8": "^4.1.11",
        "happy-dom": "^20.12.0",
        "vitest": "^4.1.11"
      },

      "frontend-dev": {
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/router-plugin": "1.168.35",
        "@tanstack/solid-query-devtools": "^5.102.8",
        "@tanstack/solid-router-devtools": "^1.167.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vite": "8.2.2",
        "vite-plugin-solid": "2.11.14"
      }
    }
  },
  "scripts": {
    "check": "turbo run check",
    "check:biome:fix": "biome check --write",
    "check:type": "turbo run check:type",

    "prepare": "husky",

    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:run": "turbo run test:run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@configs/biomejs": "workspace:*",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
