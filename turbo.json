{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "check": {
      "dependsOn": ["//#check:biome:fix", "check:type"]
    },
    "//#check:biome:fix": {
      "cache": false
    },
    "check:type": {
      "dependsOn": ["^check:type"]
    },

    "test": {
      "cache": false,
      "persistent": true
    },
    "test:run": {
      "inputs": ["src/**/*.{ts,tsx}", "vitest.config.ts", "test-setup.*"],
      "outputs": []
    },
    "test:coverage": {
      "inputs": ["src/**/*.{ts,tsx}", "vitest.config.ts", "test-setup.*"],
      "outputs": ["coverage/**"]
    }
  }
}
